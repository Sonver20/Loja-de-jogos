import sqlite3
from datetime import datetime

class BancoDeDados:
    
    def __init__(self):
        self.conexao = sqlite3.connect('banco.db')
        self.conexao.row_factory = sqlite3.Row
        self.cursor = self.conexao.cursor()
        self._criar_tabela()
        
    def __enter__(self):
        return self
    
    def __exit__(self, tipo_erro, valor_erro, traceback):
        self.close()
        return False
    
    def close(self):
        if hasattr(self, 'conexao') and self.conexao:
            self.conexao.close()
            self.conexao = None
        
    
    def _criar_tabela(self):
        self.cursor.execute('PRAGMA foreign_keys = ON')
        self.cursor.execute(
"""CREATE TABLE IF NOT EXISTS clientes (
id INTEGER PRIMARY KEY AUTOINCREMENT,nome TEXT NOT NULL,
email TEXT NOT NULL UNIQUE)""")
        self.cursor.execute(
"""CREATE TABLE IF NOT EXISTS jogos (
id INTEGER PRIMARY KEY AUTOINCREMENT,
titulo TEXT NOT NULL,
preco INTEGER NOT NULL CHECK (preco > 0),
quantidade_estoque INTEGER NOT NULL CHECK (quantidade_estoque >= 0))""")
        self.cursor.execute(
"""CREATE TABLE IF NOT EXISTS vendas (
id INTEGER PRIMARY KEY AUTOINCREMENT,
cliente_id INTEGER NOT NULL,
jogo_id INTEGER NOT NULL,
data TEXT NOT NULL,
FOREIGN KEY (cliente_id) REFERENCES clientes(id),
FOREIGN KEY (jogo_id) REFERENCES jogos(id))""")
        self.cursor.execute('CREATE INDEX IF NOT EXISTS idx_clientes_nome ON clientes(nome)')
        self.cursor.execute('CREATE INDEX IF NOT EXISTS idx_jogos_titulo ON jogos(titulo)')
        self.conexao.commit()
        self._criar_tabela_virtual()
        self._criar_trigger()
        
    def _criar_tabela_virtual(self):
        self.cursor.execute(
"""CREATE VIEW IF NOT EXISTS vendas_detalhadas
AS SELECT vendas.id, clientes.nome, jogos.titulo, jogos.preco, vendas.data
FROM vendas
JOIN clientes ON clientes.id = vendas.cliente_id
JOIN jogos ON jogos.id = vendas.jogo_id""")
        self.conexao.commit()
        
    def _criar_trigger(self):
        self.cursor.execute(
"""CREATE TRIGGER IF NOT EXISTS verficar_estoque
BEFORE INSERT ON vendas
BEGIN
    SELECT RAISE (ABORT, "Estoque esgotado")
    WHERE (SELECT quantidade_estoque FROM jogos WHERE id = NEW.jogo_id) <= 0;
END;""")
        self.conexao.commit()

    
    def contar_clientes(self):
        with self.conexao:
            total = self.cursor.execute('SELECT COUNT(*) FROM clientes').fetchone()[0]
            return total
            
    def contar_clientes_por_nome(self, termo):
            with self.conexao:
                total = self.cursor.execute('SELECT COUNT (*) FROM clientes WHERE nome LIKE ? OR nome LIKE ? OR nome LIKE ?', (termo + '%','% ' + termo + ' %', '% ' + termo)).fetchone()[0]
                return total
            
    def contar_jogos(self):
        with self.conexao:
            total = self.cursor.execute('SELECT COUNT (*) FROM jogos').fetchone()[0]
            return total
            
    def contar_jogos_por_preco(self):
        with self.conexao:
            total = self.cursor.execute('SELECT COUNT (*) FROM jogos WHERE preco > (SELECT AVG(preco) FROM jogos)').fetchone()[0]
            return total
            
    def contar_vendas(self):
        with self.conexao:
            total = self.cursor.execute('SELECT COUNT(*) FROM vendas').fetchone()[0]
            return total
    
    def contar_vendas_por_id(self, id_cliente):
        with self.conexao:
            total = self.cursor.execute('SELECT COUNT(*) FROM vendas WHERE cliente_id = ?', (id_cliente,)).fetchone()[0]
            return total
    
    def listar_flexivel(self, q1, q2):
        with self.conexao:
            qualquer_coisa = self.cursor.execute(f'SELECT {q1} FROM {q2} LIMIT ? OFFSET ?', (35, 1)).fetchall()
            return qualquer_coisa
    
    
    def listar_clientes(self, por_pagina, offset):
        with self.conexao:
            clientes = self.cursor.execute('SELECT id, nome FROM clientes ORDER BY id LIMIT ? OFFSET ?', (por_pagina, offset)).fetchall()
            return clientes
        
    def listar_jogos(self, por_pagina, offset):
        with self.conexao:
            jogos = self.cursor.execute('SELECT id, titulo, preco, quantidade_estoque FROM jogos ORDER BY id LIMIT ? OFFSET ?', (por_pagina, offset)).fetchall()
            return jogos
            
    def listar_jogos_acima_preco(self, por_pagina, offset):
        with self.conexao:
            jogos_acima = self.cursor.execute('SELECT titulo, preco FROM jogos WHERE preco  > (SELECT AVG(preco) FROM jogos) LIMIT ? OFFSET ?', (por_pagina, offset)).fetchall()
            return jogos_acima
    
    def listar_vendas(self, por_pagina, offset):
            with self.conexao:
                vendas = self.cursor.execute('SELECT * FROM vendas_detalhadas ORDER BY data DESC LIMIT ? OFFSET ?', (por_pagina, offset)).fetchall()
                return vendas
            
    def listar_compras(self, id_cliente, por_pagina, offset):
        with self.conexao:
            compras = self.cursor.execute('SELECT jogos.titulo, jogos.preco, vendas.data FROM vendas JOIN jogos ON jogos.id = vendas.jogo_id WHERE vendas.cliente_id = ? ORDER BY vendas.id DESC LIMIT ? OFFSET ?', (id_cliente, por_pagina, offset)).fetchall()
            return compras
    
    def listar_valores(self, id_cliente):
        with self.conexao:
            valores = self.cursor.execute('SELECT jogos.preco FROM vendas JOIN jogos ON jogos.id = vendas.jogo_id WHERE cliente_id = ?', (id_cliente,)).fetchall()
            return valores
    
    def adicionar_cliente(self, nome, email):
        with self.conexao:
            self.cursor.execute('INSERT INTO clientes (nome, email) VALUES (?, ?)', (nome, email))

    def adicionar_jogo(self, titulo, preco, quantidade_estoque):
        with self.conexao:
            self.cursor.execute('INSERT INTO jogos (titulo, preco, quantidade_estoque) VALUES (?, ?, ?)', (titulo, preco, quantidade_estoque))
            
    def adicionar_venda(self, id_cliente, id_jogo, data):
        with self.conexao:
            self.cursor.execute('INSERT INTO vendas (cliente_id, jogo_id, data) VALUES (?, ?, ?)', (id_cliente, id_jogo, data))


    def encontrar_cliente(self, id_cliente):
        with self.conexao:
            cliente = self.cursor.execute('SELECT nome FROM clientes WHERE id = ?', (id_cliente,)).fetchone()
            return cliente
            
    def encontrar_jogo(self, id_jogo):
        with self.conexao:
            jogo = self.cursor.execute('SELECT titulo, preco FROM jogos WHERE id = ?', (id_jogo,)).fetchone()
            return jogo


    def atualizar_estoque(self, id_jogo):
        with self.conexao:
            resultado = self.cursor.execute('UPDATE jogos SET quantidade_estoque = quantidade_estoque - 1 WHERE id = ? AND  quantidade_estoque > 0 RETURNING quantidade_estoque', (id_jogo,)).fetchone()
            return resultado


    def buscar_nome(self, termo, por_pagina, offset):
        with self.conexao:
            nomes_encontrados = self.cursor.execute('SELECT id, nome FROM clientes WHERE nome LIKE ? OR nome LIKE ? OR nome LIKE ? ORDER BY CASE WHEN nome LIKE ? THEN 0 ELSE 1 END, nome LIMIT ? OFFSET ?', (termo + '%', '% ' + termo + ' %', '% ' + termo, termo + '%', por_pagina, offset)).fetchall()
            return nomes_encontrados
            
